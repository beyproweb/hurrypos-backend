commands:
  01_install_tesseract:
    command: |
      #!/bin/bash
      set -euo pipefail

      if command -v tesseract >/dev/null 2>&1; then
        echo "Tesseract already installed: $(command -v tesseract)"
        exit 0
      fi

      if command -v dnf >/dev/null 2>&1; then
        PM="dnf"
      elif command -v yum >/dev/null 2>&1; then
        PM="yum"
      else
        echo "No supported package manager found (dnf/yum)." >&2
        exit 1
      fi

      install_tesseract_pkg() {
        local installed="false"
        for pkg in tesseract tesseract-ocr; do
          if ${PM} install -y "${pkg}" >/tmp/tesseract-install.log 2>&1; then
            installed="true"
            break
          else
            cat /tmp/tesseract-install.log || true
          fi
        done
        [[ "${installed}" == "true" ]]
      }

      echo "Installing Tesseract via ${PM}..."
      if ! install_tesseract_pkg; then
        echo "Default repos do not provide tesseract; trying EPEL fallback..."
        ${PM} install -y dnf-plugins-core || true
        ${PM} config-manager --set-enabled crb || true
        ${PM} install -y epel-release || \
        ${PM} install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm || true
        ${PM} makecache || true
        install_tesseract_pkg
      fi

      # Best-effort langpack install (names vary by distro/repo).
      ${PM} install -y tesseract-langpack-eng tesseract-langpack-tur || true
      ${PM} install -y tesseract-ocr-eng tesseract-ocr-tur || true

      if command -v tesseract >/dev/null 2>&1; then
        tesseract --version
      else
        echo "Tesseract is still unavailable; continuing with Paddle fallback path"
      fi
    ignoreErrors: true
  
  02_verify_tesseract:
    command: |
      #!/bin/bash
      set -euo pipefail
      if command -v tesseract >/dev/null 2>&1; then
        command -v tesseract
        tesseract --version
      else
        echo "Tesseract not found in verify step"
      fi
    ignoreErrors: true

container_commands:
  01_ensure_tessdata_langs:
    command: |
      #!/bin/bash
      set -euo pipefail

      if ! command -v tesseract >/dev/null 2>&1; then
        echo "tesseract binary missing after install step; skipping tessdata sync"
        exit 0
      fi

      has_eng="$(tesseract --list-langs 2>/dev/null | grep -cx 'eng' || true)"
      has_tur="$(tesseract --list-langs 2>/dev/null | grep -cx 'tur' || true)"
      if [[ "${has_eng}" -gt 0 && "${has_tur}" -gt 0 ]]; then
        echo "Tesseract languages already available: eng,tur"
        exit 0
      fi

      APP_DIR="/var/app/staging"
      TARGET=""
      for d in \
        /usr/share/tesseract/tessdata \
        /usr/share/tessdata \
        /usr/share/tesseract/4.00/tessdata \
        /usr/share/tesseract/5/tessdata
      do
        if [[ -d "${d}" ]]; then
          TARGET="${d}"
          break
        fi
      done

      if [[ -z "${TARGET}" ]]; then
        TARGET="/usr/share/tesseract/tessdata"
        mkdir -p "${TARGET}"
      fi

      if [[ "${has_eng}" -eq 0 && -f "${APP_DIR}/eng.traineddata" ]]; then
        cp -f "${APP_DIR}/eng.traineddata" "${TARGET}/eng.traineddata"
      fi
      if [[ "${has_tur}" -eq 0 && -f "${APP_DIR}/tur.traineddata" ]]; then
        cp -f "${APP_DIR}/tur.traineddata" "${TARGET}/tur.traineddata"
      fi

      tesseract --list-langs | grep -E '^(eng|tur)$' >/dev/null || true
