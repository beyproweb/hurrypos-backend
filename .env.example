# Backend Environment Configuration

# ✅ Node Environment (development or production)
NODE_ENV=development

# ✅ Server Port
PORT=5000

# ✅ Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hurrypos
DB_USER=postgres
DB_PASSWORD=your_password

# ✅ JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_here

# ✅ YemekSepeti/Trendyol Integration
YS_SECRET=your_ys_secret_here

# ✅ Redis Connection (optional, for caching)
REDIS_URL=redis://localhost:6379

# ✅ Cloudinary (for image uploads)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# ✅ Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ✅ WhatsApp Integration
WHATSAPP_API_TOKEN=your_whatsapp_token

# ✅ Iyzico Payment Gateway
IYZICO_API_KEY=your_iyzico_key
IYZICO_SECRET_KEY=your_iyzico_secret

# ✅ Ngrok URL (for local webhooks during development)
NGROK_URL=https://your-ngrok-url.ngrok.io
