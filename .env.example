# Backend Environment Configuration

# ✅ Node Environment (development or production)
NODE_ENV=development

# ✅ Server Port
PORT=5000

# ✅ Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hurrypos
DB_USER=postgres
DB_PASSWORD=your_password

# ✅ JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_here

# ✅ YemekSepeti/Trendyol Integration
YS_SECRET=your_ys_secret_here

# ✅ Redis Connection (optional, for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Set true for Redis Cloud TLS endpoints, false for plain TCP endpoints
REDIS_TLS=false

# ✅ Cloudinary (for image uploads)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# ✅ Email Service
# Production: use an HTTP provider API (Render may block SMTP ports).
EMAIL_PROVIDER=auto
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=Beypro Notifications
EMAIL_HTTP_TIMEOUT_MS=15000

# Option A (recommended): Resend
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_************************

# Option B: SendGrid
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.************************

# Option C: Mailgun
# EMAIL_PROVIDER=mailgun
# MAILGUN_API_KEY=key-************************
# MAILGUN_DOMAIN=mg.yourdomain.com
# MAILGUN_BASE_URL=https://api.mailgun.net

# Option D: Postmark
# EMAIL_PROVIDER=postmark
# POSTMARK_SERVER_TOKEN=************************
# POSTMARK_MESSAGE_STREAM=outbound

# Local development/testing SMTP only (optional)
# EMAIL_PROVIDER=smtp
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=your_email@gmail.com

# Emergency only: permit SMTP in production when API provider is unavailable.
ALLOW_SMTP_IN_PRODUCTION=false

# ✅ WhatsApp Integration
WHATSAPP_API_TOKEN=your_whatsapp_token

# ✅ Iyzico Payment Gateway
IYZICO_API_KEY=your_iyzico_key
IYZICO_SECRET_KEY=your_iyzico_secret

# ✅ Ngrok URL (for local webhooks during development)
NGROK_URL=https://your-ngrok-url.ngrok.io

# =========================
# CORS / Request size
# =========================
# Add extra allowed origins (comma-separated). Useful when testing prod API from localhost.
# Example: CORS_EXTRA_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_EXTRA_ORIGINS=

# If true, allow common localhost dev origins even when NODE_ENV=production.
CORS_ALLOW_LOCALHOST=false

# Max size for JSON / urlencoded bodies (multipart uploads are handled by multer separately)
BODY_SIZE_LIMIT=5mb

# =========================
# Internal Dev Panel (/api/internal/*)
# =========================
# Separate JWT secret so restaurant/admin JWTs cannot access /api/internal/*
INTERNAL_JWT_SECRET=your_internal_jwt_secret_key_here

# Option A (recommended): secret-based login
# POST /api/internal/auth/login { "secret": "..." }
INTERNAL_DEV_AUTH_SECRET=your_internal_dev_auth_secret_here

# Option B: email/password login
# POST /api/internal/auth/login { "email": "...", "password": "..." }
# - Prefer PASSWORD_HASH in production; plain password allowed only when NODE_ENV != production.
INTERNAL_DEV_EMAILS=dev@example.com
INTERNAL_DEV_PASSWORD_HASH=
INTERNAL_DEV_PASSWORD=

# Optional local shortcut (OFF by default):
# If true AND NODE_ENV != production AND request Origin is localhost, /api/internal/* auth is bypassed.
INTERNAL_DEV_BYPASS_LOCALHOST=false

# =========================
# Public Applications (driver/restaurant)
# =========================
# PII encryption key (required in production)
PII_ENCRYPTION_KEY=nlFTdZvM4wB2ytCKLSy+rRatEHm+Evhn8lRG/PCmGYU=

# Virus scanning for uploads (ClamAV)
# - required: reject uploads if clamscan missing
# - optional: skip if clamscan missing (dev only)
# - off: disable scanning (not recommended)
VIRUS_SCAN_MODE=optional
CLAMSCAN_PATH=clamscan

# Max upload size per file (MB) for public applications (driver-register)
APPLICATION_UPLOAD_MAX_MB=15

# Email notifications (comma-separated)
APPLICATIONS_NOTIFY_EMAILS=ops@beypro.com

# Support email shown in applicant emails (fallbacks to EMAIL_FROM/SMTP_USER if unset)
APPLICATIONS_SUPPORT_EMAIL=support@beypro.com
